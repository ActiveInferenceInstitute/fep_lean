R: matrix[1,1];
prior_cov: matrix[1,1];
prior_mean: matrix[1,1];
t: matrix[1];
u: matrix[1,1];
x: matrix[1,1];
y: matrix[1,1];

/* Parameters */
F: [[[0.36787944117144233]]];
H: [[[1.0]]];
Q: [[[0.8646647167633873]]];
R: [[[1.0]]];
diffusion_variance_rate: 2;
num_timesteps: 1;
observation_noise_variance: 1;
ou_center: 0;
ou_rate: 1;
prior_cov: [[[1.0]]];
prior_mean: [[0.0]];
step_duration: 1;

